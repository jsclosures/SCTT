app=sctt
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sctt
DB_USER=sctt
DB_PASSWORD=sctt

# ── SAML SSO Configuration ────────────────────────────────────────────────
# Set these variables to enable SAML 2.0 Single Sign-On.
# Leave SAML_IDP_SSO_URL empty to run without SAML (username/password only).
#
# SAML_IDP_SSO_URL=https://your-idp.example.com/sso/saml
# SAML_IDP_ENTITY_ID=https://your-idp.example.com
# SAML_IDP_CERT=<base64-encoded DER certificate OR PEM certificate>
#
# Optional – defaults are shown
# SAML_SP_ENTITY_ID=http://localhost:8180/saml/metadata
# SAML_SP_ACS_URL=http://localhost:8180/saml/acs
# SAML_SP_CERT=<base64 PEM SP certificate – if you want signed requests>
# SAML_SP_PRIVATE_KEY=<base64 PEM SP private key – if you want signed requests>
# SAML_ATTRIBUTE_EMAIL=email
# SAML_ATTRIBUTE_NAME=displayName
# SAML_WANT_ASSERTIONS_SIGNED=true
# SAML_WANT_AUTHN_RESPONSE_SIGNED=true
